# [APP] Server port
PORT=3000

# [DB] PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# [AUTH] JWT secrets
JWT_ACCESS_SECRET=your_strong_access_secret
JWT_REFRESH_SECRET=your_strong_refresh_secret

# [URL] Frontend / Backend base URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# [CORS] Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# [EMAIL] Gmail SMTP fallback
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# [EMAIL] Gmail API / OAuth2 (optional - if used instead of SMTP)
GMAIL_CLIENT_ID=your_google_client_id
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_google_refresh_token
GMAIL_SENDER_EMAIL=your_email@gmail.com

# [PAYMENT] ZarinPal merchant ID
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# [TELEGRAM] Error notification bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# [CLOUDINARY] Cloudinary config
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_BASE_FOLDER=course-shop

# [TEST] Enable test-only routes
ENABLE_TEST_ROUTES=false